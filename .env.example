# ========================================================
# Variáveis de Ambiente - Loja Tônia & Checkout SigiloPay
# ========================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA compartilhe o arquivo .env — ele está no .gitignore.

# SigiloPay API (Produção)
SIGILOPAY_PUBLIC_KEY=sua_public_key_aqui
SIGILOPAY_SECRET_KEY=sua_secret_key_aqui
SIGILOPAY_WEBHOOK_SECRET=

# Modo de Teste (true para simular pagamentos sem cobrar na SigiloPay)
MODO_TESTE=false

# Supabase (Opcional - Se não informado, utiliza armazenamento interno)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Meta Conversions API (CAPI) & Pixel
META_PIXEL_ID=
META_CAPI_TOKEN=

# Automação Externa (Opcional - Recuperação de Pix via WhatsApp)
WEBHOOK_AUTOMACAO_URL=
